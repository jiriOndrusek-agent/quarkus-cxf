<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.quarkiverse.cxf</groupId>
        <artifactId>quarkus-cxf-parent</artifactId>
        <version>3.40.4-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>quarkus-cxf-integration-tests</artifactId>
    <packaging>pom</packaging>

    <name>Quarkus CXF - Integration Tests</name>

    <modules>
        <module>client</module>
        <module>client-server</module>
        <module>fastinfoset</module>
        <module>server</module>
        <module>ws-security</module>
        <module>ws-security-policy</module>
        <module>ws-trust</module>
        <module>ws-rm-client</module>
        <module>mtls</module>
        <module>mtom-awt</module>
        <module>metrics</module>
        <module>mutable-jar</module>
        <module>opentelemetry</module>
        <module>saaj</module>
        <module>wsdl2java</module>
        <module>wsdl2java-no-config</module>
        <module>santuario-xmlsec</module>
    </modules>

    <properties>
        <!-- Allow running our tests against alternative BOMs, such as io.quarkus.platform:quarkus-cxf-bom -->
        <quarkus.platform.group-id>io.quarkus</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>${quarkus.version}</quarkus.platform.version>
        <quarkus-cxf.platform.group-id>io.quarkiverse.cxf</quarkus-cxf.platform.group-id>
        <quarkus-cxf.platform.artifact-id>quarkus-cxf-bom</quarkus-cxf.platform.artifact-id>
        <quarkus-cxf.platform.version>3.40.4-SNAPSHOT</quarkus-cxf.platform.version>
        <!-- This needs to be set to the underlying Quarkiverse CXF version from command line when testing against Platform BOMs -->
        <quarkus-cxf.version>3.40.4-SNAPSHOT</quarkus-cxf.version>

        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>

    <?SORTPOM IGNORE?>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus-cxf.platform.group-id}</groupId>
                <artifactId>${quarkus-cxf.platform.artifact-id}</artifactId>
                <version>${quarkus-cxf.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.cxf</groupId>
                <artifactId>quarkus-cxf-bom-test</artifactId>
                <version>${quarkus-cxf.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <?SORTPOM RESUME?>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <!-- We publish the test jars to be able to run them in Quarkus Platform project -->
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- mvn verify -Dfips
                 NSS FIPS has no ML-KEM, so the TLS handshake fails if the hybrid X25519MLKEM768 group is offered -->
            <id>fips</id>
            <activation>
                <property>
                    <name>fips</name>
                </property>
            </activation>
            <properties>
                <fips.tls.named-groups>secp256r1,secp384r1,secp521r1,ffdhe2048,ffdhe3072</fips.tls.named-groups>
                <!-- The native image builder initializes JSSE classes reading jdk.tls.namedGroups, the same groups with escaped commas -->
                <quarkus.native.additional-build-args-append>-J-Djdk.tls.namedGroups=secp256r1\,secp384r1\,secp521r1\,ffdhe2048\,ffdhe3072</quarkus.native.additional-build-args-append>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <systemPropertyVariables>
                                    <jdk.tls.namedGroups>${fips.tls.named-groups}</jdk.tls.namedGroups>
                                </systemPropertyVariables>
                            </configuration>
                        </plugin>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-failsafe-plugin</artifactId>
                            <configuration>
                                <systemPropertyVariables>
                                    <!-- the test JVM is a TLS client too, e.g. RestAssured over HTTPS -->
                                    <jdk.tls.namedGroups>${fips.tls.named-groups}</jdk.tls.namedGroups>
                                    <!-- passed to the application under test, e.g. the native binary -->
                                    <quarkus.test.arg-line>-Djdk.tls.namedGroups=${fips.tls.named-groups}</quarkus.test.arg-line>
                                </systemPropertyVariables>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>

</project>
